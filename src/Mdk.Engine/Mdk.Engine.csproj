<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Mdk.Engine</RootNamespace>
    <!-- Shader compilers for SDL_GPU's backends. A format is built when its tool runs, else skipped:
         DXIL (Direct3D 12): dxc of the Windows SDK or of the DirectXShaderCompiler release.
         SPIR-V (Vulkan): a dxc with SPIR-V (DirectXShaderCompiler release, Vulkan SDK).
         MSL (Metal): spirv-cross, from the SPIR-V.
         RequiredShaders (e.g. "spirv msl", CI) fails the build without those formats. -->
    <Dxc Condition="'$(Dxc)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">C:\Program Files (x86)\Windows Kits\10\bin\10.0.26100.0\x64\dxc.exe</Dxc>
    <DxcSpirv Condition="'$(DxcSpirv)' == '' and '$(VULKAN_SDK)' != ''">$(VULKAN_SDK)/bin/dxc</DxcSpirv>
    <DxcSpirv Condition="'$(DxcSpirv)' == ''">dxc</DxcSpirv>
    <SpirvCross Condition="'$(SpirvCross)' == '' and '$(VULKAN_SDK)' != ''">$(VULKAN_SDK)/bin/spirv-cross</SpirvCross>
    <SpirvCross Condition="'$(SpirvCross)' == ''">spirv-cross</SpirvCross>
    <ShaderDir>$(MSBuildThisFileDirectory)..\..\shaders\</ShaderDir>
    <ShaderOut>$(MSBuildThisFileDirectory)obj\shaders\</ShaderOut>
  </PropertyGroup>
  <PropertyGroup>
    <Sdl3Version>2026.722.0</Sdl3Version>
    <!-- Not runtime-agnostic: the program's runtime reaches this project (and obj/, bin/ get a
         folder per runtime). -->
    <IsRidAgnostic>false</IsRidAgnostic>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Mdk.Game.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- SDL3's native library (SDL3.dll, libSDL3.so, libSDL3.dylib) goes next to the executable. -->
    <PackageReference Include="ppy.SDL3-CS" Version="$(Sdl3Version)" />
  </ItemGroup>
  <ItemGroup>
    <!-- The window's icon (tools/gen_icon.py). -->
    <EmbeddedResource Include="..\..\assets\icon.png" LogicalName="icon.png" WithCulture="false" />
  </ItemGroup>
  <ItemGroup>
    <Shader Include="$(ShaderDir)*.hlsl" />
    <ShaderInclude Include="$(ShaderDir)*.hlsli" />
  </ItemGroup>

  <!-- Each shader file gives a vertex (vs_main) and a fragment (ps_main) program, embedded as
       shaders/<name>.vs.<format> and shaders/<name>.ps.<format> (format: dxil, spv, msl; not as
       cultures: "ps" is Pashto). -->
  <Target Name="FindShaderTools">
    <PropertyGroup>
      <ProbeDir>$(ShaderOut)probe\</ProbeDir>
    </PropertyGroup>
    <MakeDir Directories="$(ProbeDir)" />
    <WriteLinesToFile File="$(ProbeDir)probe.hlsl" Lines="float4 main() : SV_Target { return 0%3B }" Overwrite="true" WriteOnlyWhenDifferent="true" />

    <!-- Each tool compiles a probe: its exit code tells whether the tool is there and able. -->
    <Exec Condition="'$(Dxc)' != ''" Command="&quot;$(Dxc)&quot; -T ps_6_0 -E main -Fo &quot;$(ProbeDir)probe.dxil&quot; &quot;$(ProbeDir)probe.hlsl&quot;" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" StandardOutputImportance="low" StandardErrorImportance="low" EchoOff="true">
      <Output TaskParameter="ExitCode" PropertyName="DxilProbe" />
    </Exec>
    <Exec Command="&quot;$(DxcSpirv)&quot; -spirv -T ps_6_0 -E main -Fo &quot;$(ProbeDir)probe.spv&quot; &quot;$(ProbeDir)probe.hlsl&quot;" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" StandardOutputImportance="low" StandardErrorImportance="low" EchoOff="true">
      <Output TaskParameter="ExitCode" PropertyName="SpirvProbe" />
    </Exec>
    <Exec Condition="'$(SpirvProbe)' == '0'" Command="&quot;$(SpirvCross)&quot; &quot;$(ProbeDir)probe.spv&quot; --msl --output &quot;$(ProbeDir)probe.msl&quot;" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" StandardOutputImportance="low" StandardErrorImportance="low" EchoOff="true">
      <Output TaskParameter="ExitCode" PropertyName="MslProbe" />
    </Exec>

    <PropertyGroup>
      <BuildDxil>false</BuildDxil>
      <BuildDxil Condition="'$(DxilProbe)' == '0'">true</BuildDxil>
      <BuildSpirv>false</BuildSpirv>
      <BuildSpirv Condition="'$(SpirvProbe)' == '0'">true</BuildSpirv>
      <BuildMsl>false</BuildMsl>
      <BuildMsl Condition="'$(MslProbe)' == '0'">true</BuildMsl>
    </PropertyGroup>
    <Message Importance="high" Text="Shaders: DXIL $(BuildDxil), SPIR-V $(BuildSpirv), MSL $(BuildMsl) (tools: Dxc, DxcSpirv, SpirvCross)" />
    <Error Condition="!$(BuildDxil) and !$(BuildSpirv)" Text="No shader compiler: set Dxc (DXIL) or DxcSpirv (SPIR-V), see README.md" />
    <Error Condition="$(RequiredShaders.Contains('dxil')) and !$(BuildDxil)" Text="DXIL shaders required: no dxc ($(Dxc))" />
    <Error Condition="$(RequiredShaders.Contains('spirv')) and !$(BuildSpirv)" Text="SPIR-V shaders required: no dxc with SPIR-V ($(DxcSpirv))" />
    <Error Condition="$(RequiredShaders.Contains('msl')) and !$(BuildMsl)" Text="MSL shaders required: no spirv-cross ($(SpirvCross))" />
  </Target>

  <Target Name="CompileDxil" Condition="$(BuildDxil)" Inputs="@(Shader);@(ShaderInclude)" Outputs="@(Shader->'$(ShaderOut)%(Filename).vs.dxil');@(Shader->'$(ShaderOut)%(Filename).ps.dxil')">
    <Exec Command="&quot;$(Dxc)&quot; -nologo -T vs_6_0 -E vs_main -Fo &quot;$(ShaderOut)%(Shader.Filename).vs.dxil&quot; &quot;%(Shader.FullPath)&quot;" />
    <Exec Command="&quot;$(Dxc)&quot; -nologo -T ps_6_0 -E ps_main -Fo &quot;$(ShaderOut)%(Shader.Filename).ps.dxil&quot; &quot;%(Shader.FullPath)&quot;" />
  </Target>

  <!-- SPIR-V: resources in SDL_GPU's sets (shaders/bindings.hlsli). -->
  <Target Name="CompileSpirv" Condition="$(BuildSpirv)" Inputs="@(Shader);@(ShaderInclude)" Outputs="@(Shader->'$(ShaderOut)%(Filename).vs.spv');@(Shader->'$(ShaderOut)%(Filename).ps.spv')">
    <Exec Command="&quot;$(DxcSpirv)&quot; -nologo -spirv -T vs_6_0 -E vs_main -Fo &quot;$(ShaderOut)%(Shader.Filename).vs.spv&quot; &quot;%(Shader.FullPath)&quot;" />
    <Exec Command="&quot;$(DxcSpirv)&quot; -nologo -spirv -T ps_6_0 -E ps_main -Fo &quot;$(ShaderOut)%(Shader.Filename).ps.spv&quot; &quot;%(Shader.FullPath)&quot;" />
  </Target>

  <!-- MSL from the SPIR-V. The SPIR-V bindings become the Metal indices SDL_GPU wants: texture(n)
       and sampler(n) for set 2's binding n, buffer(0) for the uniforms. -->
  <Target Name="CompileMsl" Condition="$(BuildMsl)" Inputs="@(Shader->'$(ShaderOut)%(Filename).vs.spv');@(Shader->'$(ShaderOut)%(Filename).ps.spv')" Outputs="@(Shader->'$(ShaderOut)%(Filename).vs.msl');@(Shader->'$(ShaderOut)%(Filename).ps.msl')">
    <Exec Command="&quot;$(SpirvCross)&quot; &quot;$(ShaderOut)%(Shader.Filename).vs.spv&quot; --msl --msl-decoration-binding --output &quot;$(ShaderOut)%(Shader.Filename).vs.msl&quot;" />
    <Exec Command="&quot;$(SpirvCross)&quot; &quot;$(ShaderOut)%(Shader.Filename).ps.spv&quot; --msl --msl-decoration-binding --output &quot;$(ShaderOut)%(Shader.Filename).ps.msl&quot;" />
  </Target>

  <Target Name="CompileShaders" DependsOnTargets="FindShaderTools;CompileDxil;CompileSpirv;CompileMsl" />
  <Target Name="EmbedShaders" DependsOnTargets="CompileShaders" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <CompiledShader Condition="$(BuildDxil)" Include="@(Shader->'$(ShaderOut)%(Filename).vs.dxil');@(Shader->'$(ShaderOut)%(Filename).ps.dxil')" />
      <CompiledShader Condition="$(BuildSpirv)" Include="@(Shader->'$(ShaderOut)%(Filename).vs.spv');@(Shader->'$(ShaderOut)%(Filename).ps.spv')" />
      <CompiledShader Condition="$(BuildMsl)" Include="@(Shader->'$(ShaderOut)%(Filename).vs.msl');@(Shader->'$(ShaderOut)%(Filename).ps.msl')" />
      <EmbeddedResource Include="@(CompiledShader)" LogicalName="shaders/%(CompiledShader.Filename)%(CompiledShader.Extension)" WithCulture="false" />
    </ItemGroup>
  </Target>
</Project>
