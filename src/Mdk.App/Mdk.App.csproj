<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Mdk.App</RootNamespace>
    <AssemblyName>mdk</AssemblyName>
    <!-- dotnet publish -c Release -r win-x64: one native exe (shaders embedded) and SDL3.dll. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Size: 1.8 MB smaller, frame and load times unchanged (perf runs). -->
    <OptimizationPreference>Size</OptimizationPreference>
    <!-- The upscaler's download needs neither HTTP/3, tracing nor metrics. -->
    <Http3Support>false</Http3Support>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <MetricsSupport>false</MetricsSupport>
    <NativeDebugSymbols>false</NativeDebugSymbols>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <!-- The executable's icon on Windows (tools/gen_icon.py); the window's is set at run time. -->
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Mdk.Game\Mdk.Game.csproj" />
  </ItemGroup>
</Project>
