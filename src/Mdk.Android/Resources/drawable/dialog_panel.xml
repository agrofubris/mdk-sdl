<?xml version="1.0" encoding="utf-8"?>
<!-- A dialog's panel: rounded, dark teal, a thin orange rim. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="16dp">
  <shape android:shape="rectangle">
    <corners android:radius="16dp" />
    <solid android:color="@color/mdk_panel" />
    <stroke android:width="1dp" android:color="@color/mdk_rim" />
  </shape>
</inset>
