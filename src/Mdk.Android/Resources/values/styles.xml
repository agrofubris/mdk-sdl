<?xml version="1.0" encoding="utf-8"?>
<!-- The setup dialogs (Dialogs): platform Material, MDK's colours. The activity keeps its theme,
     so the game's window is untouched. -->
<resources>
  <style name="MdkDialog" parent="@android:style/Theme.Material.Dialog.Alert">
    <item name="android:windowBackground">@drawable/dialog_panel</item>
    <item name="android:colorBackground">@color/mdk_panel</item>
    <item name="android:colorAccent">@color/mdk_orange</item>
    <item name="android:colorControlActivated">@color/mdk_orange</item>
    <item name="android:textColorPrimary">@color/mdk_text</item>
    <item name="android:textColorSecondary">@color/mdk_text_dim</item>
    <item name="android:windowTitleStyle">@style/MdkDialog.Title</item>
    <item name="android:buttonBarPositiveButtonStyle">@style/MdkDialog.Primary</item>
    <item name="android:buttonBarNegativeButtonStyle">@style/MdkDialog.Secondary</item>
  </style>

  <!-- The platform's DialogWindowTitle.Material is private: its items, the colour ours. -->
  <style name="MdkDialog.Title" parent="">
    <item name="android:maxLines">1</item>
    <item name="android:ellipsize">end</item>
    <item name="android:textAppearance">@style/MdkDialog.TitleText</item>
  </style>

  <style name="MdkDialog.TitleText" parent="@android:style/TextAppearance.Material.DialogWindowTitle">
    <item name="android:textColor">@color/mdk_gold</item>
  </style>

  <!-- The answer that goes on: filled orange. -->
  <style name="MdkDialog.Primary" parent="@android:style/Widget.Material.Button">
    <item name="android:backgroundTint">@color/mdk_orange</item>
    <item name="android:textColor">@color/mdk_ink</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:minWidth">96dp</item>
    <item name="android:layout_marginStart">8dp</item>
  </style>

  <!-- The other one: orange text. -->
  <style name="MdkDialog.Secondary" parent="@android:style/Widget.Material.Button.Borderless.Colored">
    <item name="android:textColor">@color/mdk_orange</item>
    <item name="android:textAllCaps">false</item>
  </style>
</resources>
